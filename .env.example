# Public scheduling URL from Cal.com, Calendly, or Google Calendar appointment scheduling.
VITE_DISCOVERY_CALL_URL=

# HTTPS endpoint that accepts project enquiry JSON and sends the notification email.
VITE_PROJECT_ENQUIRY_ENDPOINT=

# Required by the self-hosted admin API in production. Use a long unique value.
ADMIN_PASSWORD=

# Optional local API overrides.
API_PORT=8787
DATABASE_PATH=./server/data/dashboard.sqlite
